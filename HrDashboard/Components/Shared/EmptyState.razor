<div class="hr-empty-state"><span class="hr-empty-icon"><AppIcon Name="@Icon" /></span><h3>@Title</h3><p>@Description</p>@ChildContent</div>
@code {
    [Parameter] public string Icon { get; set; } = "file";
    [Parameter] public string Title { get; set; } = "No records yet";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
