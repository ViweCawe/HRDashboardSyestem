<div class="hr-page-header">
    <div><p class="hr-eyebrow">@Eyebrow</p><h1>@Title</h1><p class="hr-page-description">@Description</p></div>
    @if (Actions is not null) { <div class="hr-header-actions">@Actions</div> }
</div>
@code {
    [Parameter] public string Eyebrow { get; set; } = "HR WORKSPACE";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? Actions { get; set; }
}
