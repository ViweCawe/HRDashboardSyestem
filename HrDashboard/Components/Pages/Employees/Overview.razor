@page "/employees/{EmploymentId:long}"
@attribute [Authorize(Policy = HrPolicies.Read)]
@inject IEmployeeRepository Employees
@inject ILogger<Overview> Logger

<PageTitle>Employee overview</PageTitle>
<a href="employees">Back to employees</a>
<h1>Employee overview</h1>
@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
else if (overview is null) { <p>Employee engagement not found.</p> }
else
{
    <h2>@overview.Employee.DisplayName</h2>
    <p>@overview.Employee.EmployeeCode · @overview.Employee.CompanyName</p>
    <p>Engaged: @overview.Employee.DateEngaged.ToString("dd/MM/yyyy") · Termination: @(overview.Employee.TerminationDate?.ToString("dd/MM/yyyy") ?? "Not recorded")</p>
    <h3>Employment engagements</h3>
    <p>These records belong to the same person. A reappointment has its own employee code.</p>
    <ul>@foreach (var e in overview.Engagements) { <li><a href="@($"employees/{e.EmploymentId}")">@e.EmployeeCode</a> — @e.DateEngaged.ToString("dd/MM/yyyy") — @(e.StatusName ?? "Not supplied")</li> }</ul>
    <h3>Snapshot history</h3>
    <div class="table-responsive"><table class="table"><thead><tr><th>As of</th><th>Status</th><th>Department</th><th>Cost centre</th><th>Job title</th><th>Employment type</th></tr></thead><tbody>
    @foreach (var h in overview.History) { <tr><td>@h.SnapshotDate.ToString("dd/MM/yyyy")</td><td>@h.StatusName</td><td>@h.DepartmentName</td><td>@h.CostCentreName</td><td>@h.JobTitleName</td><td>@(h.EmploymentTypeName ?? "Not supplied")</td></tr> }
    </tbody></table></div>
    <h3>Detected changes</h3>
    <p>Changes without a supplied effective date require HR confirmation. A job-title change is not automatically classified as a promotion.</p>
    @if (overview.Changes.Count == 0) { <p>No changes have been detected since the first snapshot.</p> }
    else { <div class="table-responsive"><table class="table"><thead><tr><th>Field</th><th>Previous value</th><th>New value</th><th>Effective date</th><th>Classification</th></tr></thead><tbody>
    @foreach (var c in overview.Changes) { <tr><td>@c.FieldName</td><td>@c.OldValue</td><td>@c.NewValue</td><td>@(c.EffectiveDate?.ToString("dd/MM/yyyy") ?? "Not supplied")</td><td>@(c.IsConfirmed ? c.ChangeType : "Awaiting HR confirmation")</td></tr> }
    </tbody></table></div> }
}
@code {
    [Parameter] public long EmploymentId { get; set; }
    private EmployeeOverview? overview;
    private string? error;
    protected override async Task OnParametersSetAsync()
    {
        error = null;
        try { overview = await Employees.GetOverviewAsync(EmploymentId); }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        { overview = null; Logger.LogError(ex, "Unable to load employee overview"); error = "Employee data is unavailable. Check the HR database configuration and deployment."; }
    }
}
