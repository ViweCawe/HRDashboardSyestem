<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- This repository uses public packages only. Keep restores independent of
       unrelated user/machine package feeds and source mappings. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
